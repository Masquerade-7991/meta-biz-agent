[
  { "id": "site-completed-zero-pages", "feature": "websites", "what": "Meta's 'completed' with 0 pages is Ready, and never claims 0 pages as fact", "input": { "kind": "view", "site": { "status": "done", "pagesRead": 0, "stalled": false } }, "expect": [{ "path": "stage", "equals": "ready" }, { "path": "line", "notRegex": "0 pages" }] },
  { "id": "site-reading-pages", "feature": "websites", "what": "While reading, the count so far is shown when Meta reports one", "input": { "kind": "view", "site": { "status": "reading", "pagesRead": 1, "stalled": false } }, "expect": [{ "path": "line", "regex": "1 page so far" }, { "path": "step", "equals": 1 }] },
  { "id": "site-stalled", "feature": "websites", "what": "A read stuck for long says so and suggests reading again", "input": { "kind": "view", "site": { "status": "waiting", "pagesRead": 0, "stalled": true } }, "expect": [{ "path": "stage", "equals": "slow" }, { "path": "tone", "equals": "warning" }] },
  { "id": "site-failed-reason", "feature": "websites", "what": "A failure carries Meta's own reason", "input": { "kind": "view", "site": { "status": "failed", "pagesRead": 0, "stalled": false, "crawlError": "robots.txt disallows crawling" } }, "expect": [{ "path": "line", "equals": "Meta couldn’t read it: robots.txt disallows crawling" }] },
  { "id": "site-pending-with-error", "feature": "websites", "what": "Pending for days but already explaining why: nothing usable, not 'queued'", "input": { "kind": "status", "status": "pending", "error": "All discovered pages are business info pages with no product data." }, "expect": [{ "path": "status", "equals": "done_no_data" }] },
  { "id": "site-unknown-status", "feature": "websites", "what": "No status from Meta yet reads as waiting", "input": { "kind": "status" }, "expect": [{ "path": "status", "equals": "waiting" }] },
  { "id": "site-covered-subpath", "feature": "websites", "what": "A page under a site already listed is covered by it (Meta reads the whole site)", "input": { "kind": "covered", "url": "https://www.shop.example/help/returns", "sites": [{ "url": "shop.example" }] }, "expect": [{ "path": "covered", "equals": "shop.example" }] },
  { "id": "site-not-covered-prefix", "feature": "websites", "what": "/shopping is not inside /shop", "input": { "kind": "covered", "url": "https://shop.example/shopping", "sites": [{ "url": "https://shop.example/shop" }] }, "expect": [{ "path": "covered", "equals": null }] },
  { "id": "site-same-url", "feature": "websites", "what": "The same address is not 'covered by itself' (re-adding reads it again)", "input": { "kind": "covered", "url": "https://shop.example/", "sites": [{ "url": "shop.example" }] }, "expect": [{ "path": "covered", "equals": null }] },
  { "id": "site-garbage-url", "feature": "websites", "what": "An unparseable address is never covered and never throws", "input": { "kind": "covered", "url": "http://[::1", "sites": [{ "url": "shop.example" }] }, "expect": [{ "path": "covered", "equals": null }] }
]
