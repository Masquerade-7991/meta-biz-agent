.env
.env.*
*.env
!.env.example
.envrc
*.pem
*.key
*.crt
*.cer
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.secret
*secret*.json
*credentials*.json
service-account*.json
client_secret*.json
id_rsa*
id_ed25519*
.npmrc
.netrc

