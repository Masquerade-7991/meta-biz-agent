{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server?p=:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/server.mjs": { "maxDuration": 60, "includeFiles": "api/_server/**" }
  },
  "crons": [{ "path": "/api/cron", "schedule": "0 3 * * *" }]
}
